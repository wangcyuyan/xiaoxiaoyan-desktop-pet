{
  "name": "com-xiaoxiaoyan-pet",
  "productName": "小小闫桌宠",
  "version": "1.1.2",
  "description": "Secure cross-platform Electron desktop pet",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "dev": "node tools/run-dev.mjs",
    "start": "node tools/run-dev.mjs",
    "check": "tsc --noEmit && node tools/validate-dev-contract.mjs && node tools/validate-spec.mjs && node tools/validate-asset-links.mjs && node tools/qa-ui.mjs && node tools/qa-experience.mjs && node tools/qa-assets.mjs",
    "test": "tsx --test tests/unit/state-machine.test.ts tests/unit/persistence.test.ts tests/unit/drag.test.ts tests/unit/typing-listener.test.ts tests/unit/experience.test.ts tests/unit/dev-ports.test.mjs tests/integration/companion.test.ts tests/integration/budget.test.ts tests/integration/affinity.test.ts tests/integration/memory-tidal.test.ts tests/integration/relation-ui.test.ts tests/integration/sse.test.ts tests/integration/bridge.test.ts tests/integration/heartbeat.test.ts tests/integration/heartbeat-display.test.ts tests/integration/e2e-companion.test.ts tests/integration/companion-integrity.test.ts tests/integration/chat-ui.test.ts tests/integration/scroll-layout.test.ts",
    "pretest:e2e": "node tools/run-build.mjs package-host",
    "test:e2e": "tsx tests/e2e/app.e2e.ts",
    "pretest:soak": "node tools/run-build.mjs package-host",
    "test:soak": "tsx tests/e2e/soak.e2e.ts",
    "pretest:soak:release": "node tools/run-build.mjs package-host",
    "test:soak:release": "tsx tests/e2e/soak.e2e.ts --duration-ms=3600000",
    "test:dev-smoke": "node tools/run-dev.mjs --smoke",
    "qa:assets": "node tools/qa-assets.mjs",
    "qa:experience": "node tools/qa-experience.mjs",
    "qa:ui": "node tools/qa-ui.mjs",
    "process:assets": "node tools/process-assets.mjs",
    "inspect:assets": "node tools/inspect-assets.mjs",
    "preflight": "node tools/preflight.mjs",
    "doctor": "node tools/doctor.mjs",
    "typing:install": "npm install --save-optional uiohook-napi@^1.5.5",
    "icon:build": "node tools/make-app-icon.mjs",
    "icon:set-shortcut": "node tools/set-shortcut-icon.mjs build/icon.ico",
    "icon:verify": "python tools/extract_pe_icon.py \"release/小小闫桌宠-win32-x64-ready-to-run/小小闫桌宠.exe\" build/verify-icons",
    "package:win": "node tools/run-build.mjs package-win",
    "make:win": "node tools/run-build.mjs installer-win",
    "portable:win": "node tools/run-build.mjs portable-win",
    "package:mac": "node tools/run-build.mjs package-mac",
    "make:mac": "node tools/run-build.mjs make-mac",
    "portable:mac": "node tools/run-build.mjs portable-mac"
  },
  "author": "Desktop Pet Builder User",
  "license": "UNLICENSED",
  "devDependencies": {
    "@electron-forge/cli": "^7.9.0",
    "@electron-forge/maker-dmg": "^7.9.0",
    "@electron-forge/maker-squirrel": "^7.9.0",
    "@electron-forge/maker-zip": "^7.9.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.9.0",
    "@electron-forge/plugin-fuses": "^7.9.0",
    "@electron-forge/plugin-webpack": "^7.9.0",
    "@electron/fuses": "^1.8.0",
    "@playwright/test": "^1.54.1",
    "@types/node": "^22.15.0",
    "css-loader": "^7.1.2",
    "electron": "37.10.3",
    "mini-css-extract-plugin": "^2.9.2",
    "sharp": "^0.34.3",
    "ts-loader": "^9.5.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9"
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "electron-winstaller@5.4.4": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false
  }
}
